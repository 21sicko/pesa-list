{
  "expo": {
    "name": "PESA LIST",
    "slug": "pesa-list",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.pesalist.app",
      "permissions": [
        "RECEIVE_SMS",
        "READ_SMS",
        "READ_PHONE_STATE"
      ],
      "blockedPermissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A6E2E"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 34,
            "targetSdkVersion": 34
          }
        }
      ],
      "expo-asset"
    ]
  }
}
